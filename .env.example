PORT=3000
ALLOWED_ORIGINS=https://mysocial.network,http://localhost:3000

REDIS_URL=redis://localhost:6379
OAUTH_STATE_SECRET=change-me-min-32-bytes-secret

# Optional HS256 fallback (legacy). Salt-service session JWTs are EdDSA via JWKS below.
JWT_SIGNING_KEY=
# DripDrop / MySocial session JWTs are issued by salt-service (EdDSA).
MYSOCIAL_AUTH_ISSUER=https://salt.testnet.mysocial.network
MYSOCIAL_AUTH_JWKS_URI=https://salt.testnet.mysocial.network/.well-known/jwks.json

X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://identity-verification.testnet.mysocial.network/oauth/x/callback

# JSON-RPC fullnode (port 9000). Do not use :443 — that endpoint is gRPC/TLS and breaks getObject.
MYSO_RPC_URL=http://fullnode.testnet.mysocial.network:9000
ECOSYSTEM_BADGE_ADMIN_CAP_ID=0x...
RELAYER_PRIVATE_KEY=
# Relayer wallet that owns ECOSYSTEM_BADGE_ADMIN_CAP_ID.
# Accepts mysoprivkey1... (from myso client/keystore) or hex flag||privkey.

# Must be the same network as MYSO_RPC_URL (testnet GraphQL ↔ testnet fullnode).
MYSO_INDEXER_GRAPHQL_URL=https://graphql.testnet.mysocial.network/graphql
EARLY_ACCESS_ENDS_AT=2026-12-31T23:59:59Z
PROFILE_URL_TEMPLATE=https://mysocial.network/@{username}
SHARE_CAMPAIGN_CHECK_DELAY_HOURS=24

BADGE_VERIFIED_X_DESCRIPTION=Verified X account linked to this profile
BADGE_VERIFIED_X_MEDIA_URL=https://assets.mysocial.network/badges/verified-x.png
BADGE_VERIFIED_X_ICON_URL=https://assets.mysocial.network/badges/verified-x-icon.png

BADGE_EARLY_ADOPTER_DESCRIPTION=Joined and promoted MySocial during Early Access
BADGE_EARLY_ADOPTER_MEDIA_URL=https://assets.mysocial.network/badges/early-adopter.png
BADGE_EARLY_ADOPTER_ICON_URL=https://assets.mysocial.network/badges/early-adopter-icon.png

BADGE_AMBASSADOR_DESCRIPTION=Active MySocial ecosystem ambassador
BADGE_AMBASSADOR_MEDIA_URL=https://assets.mysocial.network/badges/ambassador.png
ALLOW_POC_CLAIM_ATTESTATION=true
POC_SERVICE_SECRET=
